# .gitignore for my-deep-project
# Rule: code, notes, cards and proofs go in git.
# Data, secrets and anything a script can rebuild stay out.

#Data: never in git (licences and file size) 
# Ignore everything inside data/raw/ ...
/data/raw/**
# ... but keep the folders themselves visible, so the exceptions below can work
!/data/raw/**/
# ... and keep the empty-folder marker and every manifest.
# Manifests are tiny and prove what was downloaded, when, with which fingerprint.
!/data/raw/.gitkeep
!/data/raw/**/manifest.csv
logs/


# Clean data and analysis tables are rebuilt by scripts, so they stay out
/data/clean/*
!/data/clean/.gitkeep
/data/panels/
*.parquet

# Download logs DO go in git: they record versions, errors and fingerprints.
# Every other log file stays out.
*.log

# Logs produced while running studies and lessons
/studies/*/results/logs/
/lessons/*/logs/


#  Local databases
# SQLite, DuckDB and their temporary files
*.db
*.db-*
*.sqlite
*.sqlite-*
*.sqlite3
*.sqlite3-*
*.duckdb
*.duckdb.wal


#  Secrets: never in git 
# .env.example is allowed, as long as it has no real passwords or keys
.env
.env.*
!.env.example
*.pem
*.key


#Python 
__pycache__/
*.pyc
.venv/
.pytest_cache/
.ipynb_checkpoints/


# C++ (for future engines)
# Build folders
/build/
/build-*/
/cmake-build-*/
# Compiled files
*.o
*.obj
*.a
*.lib
*.so
*.so.*
*.dylib
*.dll
*.exe
# Debugger and compiler files
*.pdb
*.ilk
*.pch
*.gch
*.dSYM/
# CMake-generated files (CMakeLists.txt and CMakePresets.json stay in git)
CMakeFiles/
CMakeCache.txt
cmake_install.cmake
CTestTestfile.cmake
/compile_commands.json
/CMakeUserPresets.json


# Editor and operating-system clutter
.vs/
/.cache/
.DS_Store
Thumbs.db


# Old local folders
/organistaion/*